# Copy to .env and edit. Every variable is optional; defaults are shown.

# AI. Pick the provider and model in Settings → Automation & AI (default: the Codex CLI with a ChatGPT plan).
#   Codex CLI       no key: the ChatGPT desktop app or `npm i -g @openai/codex`, then `codex login`
#   Claude Code CLI no key: install Claude Code and sign in once by running `claude`
#   Google Gemini API: key below, from https://aistudio.google.com/apikey (free tier with limits)
#   OpenAI-compatible API (OpenAI, OpenRouter, Groq, DeepSeek, Mistral, LM Studio…): key below
#   Anthropic API: key below
#   Ollama: nothing here, just Ollama running with a model pulled
JOBAGENT_OPENAI_API_KEY=                # or OPENAI_API_KEY; the key for the server picked in Settings
JOBAGENT_GEMINI_API_KEY=                # or GEMINI_API_KEY
JOBAGENT_ANTHROPIC_API_KEY=             # or ANTHROPIC_API_KEY
JOBAGENT_LLM_BIN=                       # path to `codex` if it isn't found on PATH or in /Applications/ChatGPT.app
JOBAGENT_CLAUDE_BIN=                    # path to `claude` if it isn't found on PATH or in ~/.local/bin
JOBAGENT_LLM_MODEL=                     # Codex only: used when Settings leaves the model empty
JOBAGENT_LLM_EFFORT=low                 # minimal | low | medium | high
JOBAGENT_LLM_MAX_CALLS_PER_5H=60        # caps every provider but a local one: below your plan's limit or your API budget
JOBAGENT_LLM_MAX_CALLS_PER_DAY=150

# Ollama: as the main AI, or the optional fallback switched on in Settings → Automation & AI (used only
# when the main AI hits a limit)
JOBAGENT_OLLAMA_URL=http://127.0.0.1:11434
JOBAGENT_OLLAMA_MODEL=qwen3.5:4b

# Browser automation
JOBAGENT_BROWSER_HEADLESS=true

# Scheduler (runs while `jobagent serve` is up). Run times and the on/off switch are set in the UI.
JOBAGENT_SCHEDULER_ENABLED=true         # false = never start the scheduler at all

# Applying. auto_submit=false means the agent fills forms and screenshots them but never clicks Submit by itself.
JOBAGENT_AUTO_SUBMIT=false
JOBAGENT_AUTO_SUBMIT_SOURCES=greenhouse,lever,ashby

# Optional free API keys (aggregators stay disabled without them)
JOBAGENT_ADZUNA_APP_ID=
JOBAGENT_ADZUNA_APP_KEY=
JOBAGENT_JOOBLE_API_KEY=
JOBAGENT_REED_API_KEY=                  # UK jobs; free key from reed.co.uk/developers/jobseeker

# Server
JOBAGENT_HOST=127.0.0.1
JOBAGENT_PORT=8000
